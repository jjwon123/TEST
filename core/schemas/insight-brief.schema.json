{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InsightBrief",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "industry",
    "status",
    "minimumSelectedSignals",
    "selectedSignalCount",
    "targetHypotheses",
    "customerPains",
    "customerDesires",
    "purchaseObjections",
    "trendHooks",
    "seasonalHooks",
    "productProofs",
    "offerAngles",
    "channelPatterns",
    "doNotClaim",
    "evidenceSignalIds",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "eventId": { "type": "string" },
    "industry": { "type": "string", "enum": ["cosmetics_skincare", "jewelry_luxury"] },
    "status": { "type": "string", "enum": ["ready", "needs_signal_review"] },
    "minimumSelectedSignals": { "type": "integer", "minimum": 1 },
    "selectedSignalCount": { "type": "integer", "minimum": 0 },
    "targetHypotheses": { "type": "array", "items": { "type": "string" } },
    "customerPains": { "type": "array", "items": { "type": "string" } },
    "customerDesires": { "type": "array", "items": { "type": "string" } },
    "purchaseObjections": { "type": "array", "items": { "type": "string" } },
    "trendHooks": { "type": "array", "items": { "type": "string" } },
    "seasonalHooks": { "type": "array", "items": { "type": "string" } },
    "productProofs": { "type": "array", "items": { "type": "string" } },
    "offerAngles": { "type": "array", "items": { "type": "string" } },
    "channelPatterns": { "type": "array", "items": { "type": "string" } },
    "doNotClaim": { "type": "array", "items": { "type": "string" } },
    "evidenceSignalIds": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string" }
  }
}

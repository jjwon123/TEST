{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brief",
  "type": "object",
  "required": [
    "stage",
    "schema_version",
    "event_id",
    "event_name",
    "brand",
    "objective",
    "target",
    "schedule",
    "offer",
    "channels",
    "core_messages",
    "constraints",
    "content_direction",
    "research_context",
    "reasoning_trace",
    "quality_assessment",
    "open_questions",
    "source_files",
    "approval_status",
    "created_at"
  ],
  "properties": {
    "stage": { "type": "string", "const": "01_event_brief" },
    "schema_version": { "type": "string" },
    "event_id": { "type": "string" },
    "event_name": { "type": "string" },
    "brand": { "type": "object" },
    "objective": { "type": "object" },
    "target": { "type": "object" },
    "schedule": { "type": "object" },
    "offer": { "type": "object" },
    "channels": { "type": "array", "items": { "type": "string" } },
    "core_messages": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "object" },
    "content_direction": { "type": "object" },
    "research_context": { "type": "object" },
    "reasoning_trace": { "type": "object" },
    "quality_assessment": { "type": "object" },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "source_files": { "type": "object" },
    "approval_status": { "type": "string", "enum": ["draft", "review_pending", "approved", "rejected"] },
    "created_at": { "type": "string" }
  }
}

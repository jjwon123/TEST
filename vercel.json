{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "ui/console",
  "functions": {
    "api/index.py": {
      "includeFiles": "{runs/2026-06-03_02-26-24_여름-h-b-뷰티-세일-나이아신아마이드-집중-케어/**,events/**,references/meta_ads/**,ui/console/**,pipeline/**,services/**,core/**,scripts/**}",
      "excludeFiles": "{.tmp/**,.venv/**,0_자동화 샘플 이미지/**,화장품 예시 이미지/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/training-assets/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/meta-ad-assets/:path*",
      "destination": "/api/index"
    }
  ]
}

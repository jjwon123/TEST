# Copy this file to .env. Keep .env private; it is intentionally ignored by Git.

# Optional: structured planning through the OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-5.5
OPENAI_MAX_CALLS_PER_EVENT=8
OPENAI_REQUEST_TIMEOUT_SECONDS=90

# Optional: generic internal/external structured-generation provider.
LLM_PROVIDER_URL=
LLM_PROVIDER_TOKEN=

# Optional: research-provider endpoint.
RESEARCH_PROVIDER_URL=
RESEARCH_PROVIDER_TOKEN=

# Optional: local Ollama reference reviewer.
REFERENCE_REVIEW_HOST=http://127.0.0.1:11434
REFERENCE_REVIEW_MODEL=qwen2.5vl:7b

# Image-free transfer default. Do not approve placeholder images as final assets.
COMFYUI_GENERATION_MODE=placeholder
COMFYUI_URL=http://127.0.0.1:8188

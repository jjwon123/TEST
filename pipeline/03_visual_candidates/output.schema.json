{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Candidate Outputs",
  "type": "object",
  "required": ["stage", "event_id", "visual_plan", "prompts", "regeneration_groups", "candidates"],
  "properties": {
    "stage": { "type": "string", "const": "03_visual_candidates" },
    "event_id": { "type": "string" },
    "visual_plan": { "type": "object" },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prompt_id",
          "deliverable_id",
          "workflow_preset",
          "positive_prompt",
          "negative_prompt",
          "ratio",
          "seed",
          "sampler",
          "model",
          "batch_size",
          "candidate_count"
        ],
        "properties": {
          "prompt_id": { "type": "string" },
          "deliverable_id": { "type": "string" },
          "regeneration_group": { "type": "string" },
          "workflow_preset": { "type": "string" },
          "positive_prompt": { "type": "string" },
          "negative_prompt": { "type": "string" },
          "ratio": { "type": "string" },
          "aspect_ratio": { "type": "string" },
          "visual_role": { "type": "string" },
          "channel_id": { "type": "string" },
          "candidate_index": { "type": "integer" },
          "candidate_count": { "type": "integer" },
          "batch_size": { "type": "integer" },
          "seed": { "type": "integer" },
          "sampler": { "type": "string" },
          "model": { "type": "string" },
          "steps": { "type": "integer" },
          "cfg_scale": { "type": "number" },
          "text_safety": { "type": "object" }
        }
      }
    },
    "regeneration_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "stage_id", "scope", "candidate_ids"],
        "properties": {
          "group_id": { "type": "string" },
          "stage_id": { "type": "string", "const": "03_visual_candidates" },
          "scope": { "type": "string" },
          "deliverable_id": { "type": "string" },
          "visual_role": { "type": "string" },
          "candidate_ids": { "type": "array", "items": { "type": "string" } },
          "regenerate_command": { "type": "string" }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "deliverable_id", "regeneration_group", "status"],
        "properties": {
          "candidate_id": { "type": "string" },
          "deliverable_id": { "type": "string" },
          "regeneration_group": { "type": "string" },
          "visual_role": { "type": "string" },
          "channel_id": { "type": "string" },
          "ratio": { "type": "string" },
          "preview_path": { "type": "string" },
          "image_path": { "type": "string" },
          "source_prompt_id": { "type": "string" },
          "workflow_preset": { "type": "string" },
          "candidate_index": { "type": "integer" },
          "candidate_count": { "type": "integer" },
          "generation_status": { "type": "string" },
          "generation_error": { "type": "string" },
          "generation_mode": { "type": "string" },
          "materialized_at": { "type": "string" },
          "comfyui_submission": { "type": "object" },
          "text_safety": { "type": "object" },
          "review_metadata": { "type": "object" },
          "selection_blockers": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Channel Outputs",
  "type": "object",
  "required": ["stage", "event_id", "outputs"],
  "properties": {
    "stage": { "type": "string", "const": "05_figma_assembly" },
    "event_id": { "type": "string" },
    "figma_file_key": { "type": "string" },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["output_id", "deliverable_id", "channel_id", "template_id", "expected_export_path"],
        "properties": {
          "output_id": { "type": "string" },
          "deliverable_id": { "type": "string" },
          "channel_id": { "type": "string" },
          "template_id": { "type": "string" },
          "expected_export_path": { "type": "string" },
          "expected_dimensions": { "type": "object" },
          "copy_slots": { "type": "array", "items": { "type": "object" } },
          "asset_slots": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
